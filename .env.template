# ==============================================================================
# RED-TEAMING AGENT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in the values for your deployment
# DO NOT commit .env to version control (add to .gitignore)
#
# All variables are optional and have sensible defaults for local development.
# For production deployments, explicitly set all values.
# ==============================================================================

# ==============================================================================
# TARGET SERVICE CONFIGURATION
# ==============================================================================
# The service you want to red-team. Typically a chatbot or LLM application.

# Full URL to the target's chat/message endpoint
TARGET_CHAT_URL=http://127.0.0.1:8000/chat

# Format of HTTP requests sent to the target
# Options:
#   - json_message: {"message": "prompt text"}
#   - json_query:   {"query": "prompt text"}
#   - json_input:   {"input": "prompt text"}
#   - plain_text:   raw text body
TARGET_REQUEST_FORMAT=json_message

# HTTP method for chat endpoint
TARGET_METHOD=POST

# Health check endpoint (used to verify target is alive before attacks)
TARGET_HEALTH_ENDPOINT=/health

# ==============================================================================
# LLM PROVIDER CONFIGURATION
# ==============================================================================
# Which LLM backend to use for the red-teaming crew's agents (planner, executor, reporter)

# Primary LLM provider
# Options: ariadne (default), openai, ollama, anthropic, azure
LLM_PROVIDER=ariadne

# LLM temperature (0.0 = deterministic, 1.0 = creative)
# Lower values for consistent strategy execution
# Higher values for diverse attack generation
LLM_TEMPERATURE=0.7

# Maximum tokens per LLM response
LLM_MAX_TOKENS=4096

# ---- ARIADNE-SPECIFIC (if LLM_PROVIDER=ariadne) ----
# API token for authentication
ARIADNE_API_TOKEN=your_token_here

# Base URL for Ariadne API
ARIADNE_BASE_URL=https://ariadne.issel.ee.auth.gr/api

# Cloud provider (gcp, aws, or custom)
ARIADNE_PROVIDER=gcp

# ---- OPENAI-SPECIFIC (if LLM_PROVIDER=openai) ----
# Your OpenAI API key
OPENAI_API_KEY=sk-...

# OpenAI model name (e.g., gpt-4, gpt-4-turbo, gpt-3.5-turbo)
OPENAI_MODEL=gpt-4

# ---- OLLAMA-SPECIFIC (if LLM_PROVIDER=ollama) ----
# Ollama server address (for local or remote Ollama instances)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model to use (must be already pulled on the Ollama server)
OLLAMA_MODEL=llama3.2:1b

# ==============================================================================
# KNOWLEDGE BASE & RAG CONFIGURATION
# ==============================================================================
# Configuration for the vector database that helps the planner choose attacks

# Path where Chroma vector database is stored
# Absolute paths recommended for production, relative works for local development
KNOWLEDGE_BASE_PATH=./chroma_db

# Embedding provider for converting text to vectors
# Options: huggingface (default), openai, cohere
EMBEDDING_PROVIDER=huggingface

# Embedding model name
# HuggingFace options: all-MiniLM-L6-v2 (small, fast), all-mpnet-base-v2 (large, accurate)
# OpenAI: text-embedding-3-small, text-embedding-3-large
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Document chunk size (characters) for RAG splitting
# Smaller = more granular retrieval, faster processing
# Larger = more context per chunk, fewer chunks to search
CHUNK_SIZE=1000

# Overlap between chunks (characters)
# Higher overlap ensures concepts split across chunk boundaries are captured
CHUNK_OVERLAP=200

# ---- WEB SCRAPING (Optional) ----
# API key for Serper (Google search API)
# Get free tier at https://serper.dev
# Leave empty to skip web-based documentation scraping
SERPER_API_KEY=

# ==============================================================================
# ATTACK EXECUTION CONFIGURATION
# ==============================================================================
# Parameters that control how attacks are delivered to the target

# Predefined attack strategy profile
# Options:
#   - local_fast:      Low delays, tight timeouts (for localhost targets)
#   - remote_api:      Moderate delays, relaxed timeouts (for cloud targets)
#   - rate_limited:    Long delays between requests, generous timeouts
ATTACK_STRATEGY=local_fast

# Delay between consecutive prompts (seconds)
# Respects rate limits and gives target time to process
INTER_PROMPT_DELAY=0.5

# Timeout for individual HTTP requests (seconds)
ATTACK_REQUEST_TIMEOUT=15

# Polling interval while waiting for job completion (seconds)
# Used if target returns a job_id and we need to poll for results
ATTACK_JOB_POLL_INTERVAL=0.5

# Overall timeout for a job to complete (seconds)
ATTACK_JOB_TIMEOUT=120

# Use external Promptfoo CLI instead of direct HTTP mode
# 0 = use direct HTTP mode (default, simpler)
# 1 = generate config and run promptfoo CLI (requires npm install)
USE_PROMPTFOO=0

# ==============================================================================
# AGENT & WORKFLOW CONFIGURATION
# ==============================================================================
# Controls the behavior and personality of the red-teaming agents

# Agent profile that defines roles, goals, and backstories
# Available profiles can be defined in config/agent_profiles.yaml
# Options: red_team_specialist (default), probing_specialist, custom
AGENT_PROFILE=red_team_specialist

# Final report output format
# Options: pdf_default (PDF with professional styling), html_debug, json_structured
REPORT_FORMAT=pdf_default

# Enable verbose logging from agents
# true = see all reasoning and tool calls (helpful for debugging)
# false = minimal output, only final results
VERBOSE=true

# ==============================================================================
# TARGET APPLICATION CONFIGURATION
# ==============================================================================
# Used ONLY if you're running target_app/vulnerable_chatbot.py locally

# Ollama model for the target chatbot (must be installed on your Ollama server)
# Run `ollama list` to see available models
# Common: llama3.2:1b (small, fast), llama2 (medium), llama3:70b (large, accurate)
OLLAMA_MODEL=llama3.2:1b

# Temperature for target app's LLM (0.0 = deterministic, 1.0 = creative)
# Typically lower for stable, predictable target behavior
TARGET_TEMPERATURE=0

# Max reasoning steps the target agent can take
# Lower = faster, but may refuse complex requests
# Higher = more steps, may expose reasoning flaws
MAX_AGENT_ITERATIONS=10

# Max execution time for target agent (seconds)
# Prevents infinite loops and resource exhaustion
MAX_AGENT_EXECUTION_TIME=40

# Comma-separated list of commands the target agent is allowed to execute
# Add to this list only for intentional testing scenarios
# Remove commands to increase security of the practice target
SAFE_COMMANDS=whoami,echo,dir,cd,ping,help

# ==============================================================================
# DEBUGGING & ADVANCED OPTIONS
# ==============================================================================

# Enable detailed HTTP request/response logging
DEBUG_HTTP=false

# Save all raw agent responses to a debug log file
DEBUG_SAVE_AGENT_RESPONSES=false

# Pretty-print JSON payloads in logs
DEBUG_JSON_PRETTY_PRINT=true

# Custom logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ==============================================================================
# END OF CONFIGURATION
# ==============================================================================
# For more information, see HARDCODED_ANALYSIS.md
