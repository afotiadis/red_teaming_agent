# Example environment variables for red_teaming_agent
# Copy to .env and fill in your secrets.

# LLM selection
LLM_BACKEND=openrouter            # openrouter | ariadne

# OpenRouter API
OPENROUTER_API_KEY=sk-or-REPLACE_ME
OPENROUTER_MODEL=openai/gpt-oss-120b:free
OPENROUTER_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192
OPENROUTER_TIMEOUT=120

# Optional reasoning controls (gpt-oss supports reasoning tokens)
OPENROUTER_REASONING_ENABLED=true
OPENROUTER_REASONING_EFFORT=medium
OPENROUTER_REASONING_MAX_TOKENS=2000

# Optional headers to help OpenRouter attribute usage
OPENROUTER_HTTP_REFERER=https://your.app.example
OPENROUTER_X_TITLE=MyRedTeamTool

# Preserve Ariadne tokens for future use
ARIADNE_API_TOKEN=sk-proj-REPLACE_ME

# Other project envs (examples)
TARGET_CHAT_URL=http://127.0.0.1:8000/chat
SERPER_API_KEY=REPLACE_ME
