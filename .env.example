# Example environment variables for red_teaming_agent
# Copy to .env and fill in your secrets.

# LLM selection
LLM_BACKEND=openrouter            # openrouter | ariadne

# Target selection. The profile supplies localhost URLs and the request schema.
# Options: zero_health | dvaia | vuln_bank | vulnerable_chat | generic
TARGET_APP=vulnerable_chat

# Optional: change only the host/port while retaining the selected profile paths.
# TARGET_BASE_URL=http://localhost:5000

# Required for the authenticated zero_health and vuln_bank profiles.
# TARGET_AUTH_TOKEN=REPLACE_ME

# Advanced per-contract overrides (normally leave unset).
# TARGET_CHAT_URL=http://localhost:5000/custom/chat
# TARGET_HEALTH_URL=http://localhost:5000/custom/health
# TARGET_REQUEST_FIELD=message
# TARGET_REQUEST_FORMAT=json_message

# OpenRouter API
OPENROUTER_API_KEY=sk-or-REPLACE_ME
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192
OPENROUTER_TIMEOUT=120

# Optional reasoning controls (gpt-oss supports reasoning tokens)
OPENROUTER_REASONING_ENABLED=true
OPENROUTER_REASONING_EFFORT=medium
OPENROUTER_REASONING_MAX_TOKENS=2000

# Optional headers to help OpenRouter attribute usage
OPENROUTER_HTTP_REFERER=https://your.app.example
OPENROUTER_X_TITLE=MyRedTeamTool

# Preserve Ariadne tokens for future use
ARIADNE_API_TOKEN=sk-proj-REPLACE_ME

# Other project envs (examples)
SERPER_API_KEY=REPLACE_ME
