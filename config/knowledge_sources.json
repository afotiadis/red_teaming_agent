{
  "repositories": [
    {
      "name": "promptfoo",
      "url": "https://github.com/promptfoo/promptfoo.git",
      "enabled": true,
      "doc_patterns": ["**/*.md", "docs/**/*.mdx"]
    },
    {
      "name": "pyrit",
      "url": "https://github.com/Azure/PyRIT.git",
      "enabled": true,
      "doc_patterns": ["**/*.md", "docs/**/*"]
    },
    {
      "name": "agentic-radar",
      "url": "https://github.com/splx-ai/agentic-radar.git",
      "enabled": true,
      "doc_patterns": ["**/*.md", "docs/**/*"]
    }
  ],
  "web_searches": [
    {
      "query": "site:promptfoo.dev/docs",
      "enabled": true
    },
    {
      "query": "site:azure.github.io/PyRIT",
      "enabled": true
    }
  ],
  "local_documents": [
    {
      "name": "gandalf-skill",
      "path": "skills/gandalf-ctf/SKILL.md",
      "enabled": true
    },
    {
      "name": "attack-taxonomy",
      "path": "data/attack_knowledge/taxonomy.md",
      "enabled": true
    },
    {
      "name": "final-campaign-playbooks",
      "path": "data/attack_knowledge/final_campaign_playbooks.md",
      "enabled": true
    },
    {
      "name": "experiential-memory",
      "path": "data/experiential_memory/log.md",
      "enabled": true
    }
  ]
}
